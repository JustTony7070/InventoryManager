<UserControl x:Class="InventoryManager.UserControls.ProductsSideSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InventoryManager.UserControls"
             mc:Ignorable="d" 
             d:Height="450" d:DesignWidth="266">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="NewValueSection">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontWeight" Value="Light"/>
        </Style>
        <Style TargetType="TextBox" x:Key="NewValueField">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxLines" Value="3"/>
            <Setter Property="Width" Value="300"/>
        </Style>
    </UserControl.Resources>

    <!--#region NewValue Fields-->
    <Grid Grid.Column="2" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding B_ActionTitle,UpdateSourceTrigger=PropertyChanged,FallbackValue=ActionText}" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>

        <!--#region Fields-->
        <Viewbox Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Orientation="Vertical" Margin="10">
                <TextBlock Style="{StaticResource NewValueSection}" Text="Name"/>
                <TextBox Style="{StaticResource NewValueField}" x:Name="tbx_Name" 
                    Text="{Binding B_NewName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource NewValueSection}" Text="Quantity"/>
                <TextBox Style="{StaticResource NewValueField}" x:Name="tbx_Quantity" 
                    Text="{Binding B_NewQuantity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource NewValueSection}" Text="Price"/>
                <TextBox Style="{StaticResource NewValueField}" x:Name="tbx_Price" 
                    Text="{Binding B_NewPrice,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource NewValueSection}" Text="Code"/>
                <TextBox Style="{StaticResource NewValueField}" x:Name="tbx_Code" MaxLength="10"
                    Text="{Binding B_NewCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="AutoGenerate Unique Code" FontSize="16" Command="{Binding AutoGenerateCodeCommand}"/>
            </StackPanel>
        </Viewbox>
        <!--#endregion-->

        <!--#region Buttons-->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30">
            <Button Content="Confirm" Foreground="Green" Width="100" Height="50" FontSize="16" Command="{Binding ConfirmCommand}"/>
            <Button Content="Cancel" Width="100" Height="50" FontSize="16" Margin="20,0,0,0" Command="{Binding CancelCommand}"/>
        </StackPanel>
        <!--#endregion-->
    </Grid>
    <!--#endregion-->
</UserControl>
