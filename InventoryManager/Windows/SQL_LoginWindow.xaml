<Window x:Class="InventoryManager.Windows.SQL_LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InventoryManager.Windows"
        mc:Ignorable="d" WindowStartupLocation="CenterOwner"
        Title="MySQL_LoginWindow" Height="450" Width="450">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height=".9*"/>
            <RowDefinition Height=".1*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="MySQL Login" FontWeight="Bold" FontSize="40" HorizontalAlignment="Center"/>

        <!--#region Fields-->
        <Viewbox Grid.Row="1" Margin="20">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Server IP"/>
                    <TextBox x:Name="tb_Server"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Database Name"/>
                    <TextBox x:Name="tb_DbName"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="User ID"/>
                    <TextBox x:Name="tb_UserID"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Password"/>
                    <PasswordBox Width="200" Margin="0,20,0,0" HorizontalContentAlignment="Center" x:Name="Password"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,20,0,0">
                    <CheckBox Content="Save Connection" Margin="0,0,0,10" IsChecked="{Binding B_SaveConnCheck}"/>
                    <ComboBox ItemsSource="{Binding B_SqlConnectionsList}" SelectedItem="{Binding B_SqlConnListSelected}"/>
                    <Button Content="Delete Selected" HorizontalAlignment="Center" FontSize="16" HorizontalContentAlignment="Center"
                            Margin="0,10,0,0" Command="{Binding DeleteSelectedSqlConnCommand}"/>
                </StackPanel>
            </StackPanel>
        </Viewbox>
        <!--#endregion-->
        
        <!--#region Buttons-->
        <Viewbox Grid.Row="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Content="Confirm" Foreground="Green" Height="50" Width="100" FontSize="16" IsDefault="True" Command="{Binding ConfirmCommand}"/>
                <Button Content="Cancel" Height="50" Width="100" FontSize="16" Margin="20,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Viewbox>
        <!--#endregion-->
    </Grid>
</Window>
