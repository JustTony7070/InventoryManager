<Window x:Class="InventoryManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InventoryManager"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        Title="Inventory Manager" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!--#region Name-->
        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="Inventory Management" FontWeight="Bold" FontSize="40"/>
        <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="Version 4.5" FontSize="10" Margin="5,0,0,0" FontWeight="Light"/>
        <!--#endregion-->
        
        <!--#region ToolBar-->
        <ToolBar Grid.Row="1" VerticalAlignment="Center">
            <Button x:Name="btn_New" Content="New" IsEnabled="{Binding B_NewEnabled,UpdateSourceTrigger=PropertyChanged}" Command="{Binding NewCommand}"
                    FontSize="16"/>
            <Button x:Name="btn_Edit" Content="Edit" IsEnabled="{Binding B_EditEnabled,UpdateSourceTrigger=PropertyChanged}" Command="{Binding EditCommand}"
                    FontSize="16"/>
            <Button x:Name="btn_Delete" Content="Delete" IsEnabled="{Binding B_DelEnabled,UpdateSourceTrigger=PropertyChanged}" Command="{Binding DeleteCommand}"
                    FontSize="16"/>
            <Separator/>
            <Button x:Name="btn_SqlConn" Content="{Binding B_SqlButtonContent,UpdateSourceTrigger=PropertyChanged,FallbackValue=Connect_To_SQL}" 
                    Command="{Binding ConnectCommand}" FontSize="16"/>
            <TextBlock x:Name="tb_SqlStatus" Text="{Binding B_ConnectionStatus,UpdateSourceTrigger=PropertyChanged,FallbackValue=Connection_Status:_Not_Connected}" 
                       VerticalAlignment="Center" Margin="5,0,0,0" 
                       Foreground="{Binding B_ConnectionColor,UpdateSourceTrigger=PropertyChanged}" FontSize="16"/>
            <Separator/>
            <Button x:Name="btn_ExportData" Content="Export Data" FontSize="16" Command="{Binding ExportDataCommand}"/>
            <Button x:Name="btn_LoadData" Content="Load Data" FontSize="16" Command="{Binding LoadDataCommand}" IsEnabled="{Binding B_LoadDataEnabled}"/>
            <Button x:Name="btn_SelectPath" Content="Select Path" FontSize="16" Command="{Binding SelectPathCommand}"/>
            <Separator/>
            <Button x:Name="btn_ClearTable" Content="Clear Table" FontSize="16" Command="{Binding ClearTableCommand}" IsEnabled="{Binding B_ClearTableEnabled}"/>
        </ToolBar>
        <!--#endregion-->
        
        <!--#region DataGrids-->
        <Grid Grid.Row="3" x:Name="grid_MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="{Binding B_SplitterWidth,FallbackValue=0}"/>
                <ColumnDefinition MaxWidth="{Binding B_SideSectionMaxWidth,FallbackValue=0}" Width="{Binding B_SideSectionWidth}"
                                  MinWidth="{Binding B_SideSectionMinWidth}"/>
            </Grid.ColumnDefinitions>

            <TabControl x:Name="tc_TableSelector" Grid.Row="3" FontSize="16" SelectedIndex="{Binding B_TableSelectorIndex,Mode=TwoWay,FallbackValue=0}">
                <TabItem Header="Products">
                    <DataGrid CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" x:Name="dg_DataGrid"
                      ItemsSource="{Binding B_DataGrid, Mode=OneWay,UpdateSourceTrigger=PropertyChanged}" ColumnWidth="1*" 
                      HorizontalContentAlignment="Center" SelectedItem="{Binding B_SelectedItemProductTable,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                      FontSize="16"/>   
                </TabItem>
                <TabItem Header="Orders">
                    <DataGrid CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" x:Name="dg_CustomersDataGrid"
                        ItemsSource="{Binding B_CustomersDataGrid, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" ColumnWidth="1*" AutoGenerateColumns="False"
                        HorizontalContentAlignment="Center" SelectedItem="{Binding B_SelectedItemCustomerTable, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" FontSize="16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" />

                            <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" />

                            <DataGridTemplateColumn Header="Products Quantities">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                                            <TextBlock Text="{Binding Products_Quantities}" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" />

                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch">
                <GridSplitter.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Transparent"/>
                        <GradientStop Color="Black" Offset=".5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </GridSplitter.Background>
            </GridSplitter>

            <ContentControl Grid.Column="2" Content="{Binding B_SideSectionUserControl}"/>
        </Grid>
        <!--#endregion-->
        
        <!--#region Search Bar-->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal">
            <GroupBox BorderThickness="0" VerticalAlignment="Center" Margin="0,5,0,0">
                <Grid>
                    <TextBox x:Name="tbx_SearchBar" Grid.Row="2" HorizontalAlignment="Center" MinWidth="200" FontSize="20" Background="Transparent"
                             TextWrapping="Wrap" MaxWidth="500" MaxLines="2" Text="{Binding B_SearchBarText,UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="tb_SearchText" Grid.Row="2" HorizontalAlignment="Center" Text="Search🔍" FontSize="20" 
                               Opacity="{Binding B_SearchTextOpacity,UpdateSourceTrigger=PropertyChanged,FallbackValue=.5}" Panel.ZIndex="-1"/>
                </Grid>
            </GroupBox>
            <ComboBox Margin="10,0,0,0" Width="auto" VerticalAlignment="Center" SelectedItem="{Binding B_SearchType}"
                      HorizontalContentAlignment="Center" FontSize="16" ItemsSource="{Binding B_SearchTypeList}"/>
            <Button x:Name="btn_Search" Content="Search" Width="60" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0" Command="{Binding SearchCommand}"/>
        </StackPanel>
        <!--#endregion-->
    </Grid>
</Window>
